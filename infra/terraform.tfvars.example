# Copy to terraform.tfvars (gitignored) and fill in. These values populate
# Secrets Manager — they are NEVER committed.
openai_api_key = "sk-..."
neo4j_uri      = "neo4j+s://xxxx.databases.neo4j.io"
neo4j_user     = "neo4j"
neo4j_password = "..."
qdrant_url     = "https://xxxx.cloud.qdrant.io:6333"
qdrant_api_key = "..."
api_keys       = "generate-a-long-random-key-here"

# Optional overrides:
# region      = "eu-central-1"
# task_cpu    = 512
# task_memory = 1024
